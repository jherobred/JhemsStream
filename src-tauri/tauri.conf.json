{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JhemsStream",
  "version": "0.5.0",
  "identifier": "com.jherobred.jhemsstream",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "JhemsStream",
        "width": 1440,
        "height": 900,
        "minWidth": 640,
        "minHeight": 480,
        "maximized": true,
        "decorations": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": { "resources/stingers/*": "stingers/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyRTUzRTUzQjMwQjQyNDMKUldSRFFndXpVejdsZ3VpWnNycTJyOWhHUzZYemFvQ2drT3hVOEVERlMwcHV6MnRUME5wK3U5OGYK",
      "endpoints": ["https://github.com/jherobred/JhemsStream/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
